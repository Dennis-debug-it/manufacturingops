info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (77ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @ef_filter__CurrentTenantFilterId7='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."AssetId", p."AutoAssign", p."AutoSchedule", p."BranchId", p."CreatedAt", p."DaysBeforeDue", p."DefaultAssignmentGroupId", p."Frequency", p."FrequencyInterval", p."FrequencyUnit", p."LastGeneratedAt", p."LastPmDate", p."LastPmWorkOrderId", p."MeterBuffer", p."MeterInterval", p."NextPmDate", p."NotifyOnGeneration", p."PmTemplateId", p."PreferredDayOfMonth", p."PreferredDayOfWeek", p."SiteId", p."Status", p."TenantId", p."TriggerType", p."UpdatedAt", a0."Id", a0."AssetCategoryId", a0."AssetCode", a0."AssetName", a0."AssetType", a0."AutoSchedulePm", a0."BranchId", a0."BuildingBlock", a0."CapacityRating", a0."ClientId", a0."CommissioningDate", a0."CreatedAt", a0."CurrentMeterReading", a0."DecommissionDate", a0."DefaultAssignmentGroupId", a0."FloorLevel", a0."InstallationDate", a0."LastPmDate", a0."Location", a0."LocationDescription", a0."Manufacturer", a0."MeterBuffer", a0."MeterInterval", a0."MeterLabel", a0."Model", a0."NextPmDate", a0."Notes", a0."OwnershipType", a0."PhysicalDescription", a0."PmFrequencyUnit", a0."PmFrequencyValue", a0."RecommendedPmFrequency", a0."RoomArea", a0."SerialNumber", a0."SiteId", a0."Status", a0."SystemId", a0."TenantId", a0."UpdatedAt", a0."WarrantyExpiryDate", a0."YearOfManufacture", p1."Id", p1."AssetCategoryId", p1."AutoScheduleByDefault", p1."Category", p1."Code", p1."CreatedAt", p1."DefaultIntervalMonths", p1."DeletedAt", p1."DeletedByUserId", p1."Description", p1."EstimatedDurationHours", p1."IsActive", p1."IsPlatformSeed", p1."IsSystemTemplate", p1."Name", p1."OptionalReportSectionsJson", p1."SourceTemplateId", p1."TemplatePackId", p1."TenantId", p1."UpdatedAt", p1."Version", p1."WorkType", s."Id", s."CreatedAt", s."DefaultValue", s."DisplayOrder", s."EvidenceRequired", s."HelperText", s."IsActive", s."IsRequired", s."MaxValue", s."MinValue", s."OptionsJson", s."PmTemplateId", s."Prompt", s."RequiresNoteOnFail", s."ResponseType", s."SectionId", s."SectionName", s."TechnicianRemarksAllowed", s."Unit", s."UpdatedAt", s."Id0", s."CreatedAt0", s."Description", s."DisplayOrder0", s."IsActive0", s."PmTemplateId0", s."SectionName0", s."UpdatedAt0"
      FROM preventive_maintenance_plans AS p
      INNER JOIN (
          SELECT a."Id", a."AssetCategoryId", a."AssetCode", a."AssetName", a."AssetType", a."AutoSchedulePm", a."BranchId", a."BuildingBlock", a."CapacityRating", a."ClientId", a."CommissioningDate", a."CreatedAt", a."CurrentMeterReading", a."DecommissionDate", a."DefaultAssignmentGroupId", a."FloorLevel", a."InstallationDate", a."LastPmDate", a."Location", a."LocationDescription", a."Manufacturer", a."MeterBuffer", a."MeterInterval", a."MeterLabel", a."Model", a."NextPmDate", a."Notes", a."OwnershipType", a."PhysicalDescription", a."PmFrequencyUnit", a."PmFrequencyValue", a."RecommendedPmFrequency", a."RoomArea", a."SerialNumber", a."SiteId", a."Status", a."SystemId", a."TenantId", a."UpdatedAt", a."WarrantyExpiryDate", a."YearOfManufacture"
          FROM assets AS a
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR a."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS a0 ON p."AssetId" = a0."Id"
      LEFT JOIN (
          SELECT p0."Id", p0."AssetCategoryId", p0."AutoScheduleByDefault", p0."Category", p0."Code", p0."CreatedAt", p0."DefaultIntervalMonths", p0."DeletedAt", p0."DeletedByUserId", p0."Description", p0."EstimatedDurationHours", p0."IsActive", p0."IsPlatformSeed", p0."IsSystemTemplate", p0."Name", p0."OptionalReportSectionsJson", p0."SourceTemplateId", p0."TemplatePackId", p0."TenantId", p0."UpdatedAt", p0."Version", p0."WorkType"
          FROM pm_templates AS p0
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR p0."TenantId" = @ef_filter__CurrentTenantFilterId7
      ) AS p1 ON p."PmTemplateId" = p1."Id"
      LEFT JOIN (
          SELECT p2."Id", p2."CreatedAt", p2."DefaultValue", p2."DisplayOrder", p2."EvidenceRequired", p2."HelperText", p2."IsActive", p2."IsRequired", p2."MaxValue", p2."MinValue", p2."OptionsJson", p2."PmTemplateId", p2."Prompt", p2."RequiresNoteOnFail", p2."ResponseType", p2."SectionId", p2."SectionName", p2."TechnicianRemarksAllowed", p2."Unit", p2."UpdatedAt", p3."Id" AS "Id0", p3."CreatedAt" AS "CreatedAt0", p3."Description", p3."DisplayOrder" AS "DisplayOrder0", p3."IsActive" AS "IsActive0", p3."PmTemplateId" AS "PmTemplateId0", p3."SectionName" AS "SectionName0", p3."UpdatedAt" AS "UpdatedAt0"
          FROM pm_template_questions AS p2
          LEFT JOIN pm_template_sections AS p3 ON p2."SectionId" = p3."Id"
      ) AS s ON p1."Id" = s."PmTemplateId"
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR p."TenantId" = @ef_filter__CurrentTenantFilterId) AND p."Status" = 'Active' AND p."NextPmDate" IS NOT NULL
      ORDER BY p."Id", a0."Id", p1."Id", s."Id"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (6ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @plan_Id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT EXISTS (
          SELECT 1
          FROM work_orders AS w
          WHERE (@ef_filter__ShouldBypassTenantFilter2 OR w."TenantId" = @ef_filter__CurrentTenantFilterId) AND w."PreventiveMaintenancePlanId" = @plan_Id AND w."Status" <> 'Completed' AND w."Status" <> 'Cancelled')
