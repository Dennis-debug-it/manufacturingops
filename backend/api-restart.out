info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (2ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @tenantId='?' (DbType = Guid), @monthStart='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
