kedAt", c2."GracePeriodAllowsSla", c2."GracePeriodDays", c2."GracePeriodPolicy", c2."IncludedServices", c2."InternalApproverUserId", c2."IsArchived", c2."LastReminderSentAt", c2."Name", c2."NextReminderAt", c2."Notes", c2."PauseSlaOnHold", c2."PriorityLevel", c2."RenewalBehavior", c2."RenewalNoticeDays", c2."RenewalOwnerUserId", c2."RenewalRisk", c2."RenewalStartedAt", c2."RenewedFromContractId", c2."RenewedToContractId", c2."ResolutionTimeHours", c2."ResponseTimeHours", c2."SlaMatrixJson", c2."StartDate", c2."Status", c2."SubmittedForApprovalAt", c2."SuspensionReason", c2."TenantId", c2."TerminationDate", c2."TerminationReason", c2."UpdatedAt", c2."WorkingHoursPolicy", c4."Id", c4."ContractId", c4."CreatedAt", c4."Currency", c4."Description", c4."EffectiveFrom", c4."EffectiveTo", c4."IsActive", c4."IsDefault", c4."Name", c4."TenantId", c4."UpdatedAt", t0."Id", t0."ActiveWorkOrderId", t0."AssignmentGroup", t0."AvailabilityNote", t0."AvailabilityStatus", t0."AvailabilityUntil", t0."AvailabilityUpdatedAt", t0."BranchId", t0."CreatedAt", t0."Email", t0."FullName", t0."IsActive", t0."IsTrackingActive", t0."LastKnownLatitude", t0."LastKnownLongitude", t0."LastLocationAt", t0."Phone", t0."SkillCategory", t0."TenantId", t0."UpdatedAt", t0."UserId", t2."Id", t2."ActiveWorkOrderId", t2."AssignmentGroup", t2."AvailabilityNote", t2."AvailabilityStatus", t2."AvailabilityUntil", t2."AvailabilityUpdatedAt", t2."BranchId", t2."CreatedAt", t2."Email", t2."FullName", t2."IsActive", t2."IsTrackingActive", t2."LastKnownLatitude", t2."LastKnownLongitude", t2."LastLocationAt", t2."Phone", t2."SkillCategory", t2."TenantId", t2."UpdatedAt", t2."UserId", a4."Id", a4."BranchId", a4."CreatedAt", a4."Description", a4."IsActive", a4."Name", a4."SkillArea", a4."TenantId", a4."UpdatedAt", b0."Id", b0."Address", b0."Code", b0."ContactPerson", b0."CreatedAt", b0."Email", b0."IsActive", b0."Location", b0."Name", b0."ParentBranchId", b0."Phone", b0."TenantId", b0."UpdatedAt", p0."Id", s3."Id", s3."AssignedAt", s3."AssignedByUserId", s3."AssignmentGroupId", s3."AssignmentStatus", s3."CreatedAt", s3."Notes", s3."TenantId", s3."UpdatedAt", s3."WorkOrderId", s3."Id0", s3."BranchId", s3."CreatedAt0", s3."Description", s3."IsActive", s3."Name", s3."SkillArea", s3."TenantId0", s3."UpdatedAt0", w4."Id", w4."ActorUserId", w4."CreatedAt", w4."EventType", w4."Latitude", w4."Longitude", w4."Message", w4."NewStatus", w4."Note", w4."OccurredAt", w4."OldStatus", w4."Reason", w4."Status", w4."TenantId", w4."UpdatedAt", w4."WorkOrderId", s4."Id", s4."AcceptedAt", s4."ArrivalAt", s4."AssignedAt", s4."AssignedByUserId", s4."CreatedAt", s4."DeclinedAt", s4."DepartureAt", s4."IsLead", s4."Notes", s4."Status", s4."TechnicianId", s4."TenantId", s4."UpdatedAt", s4."WorkOrderId", s4."Id0", s4."ActiveWorkOrderId", s4."AssignmentGroup", s4."AvailabilityNote", s4."AvailabilityStatus", s4."AvailabilityUntil", s4."AvailabilityUpdatedAt", s4."BranchId", s4."CreatedAt0", s4."Email", s4."FullName", s4."IsActive", s4."IsTrackingActive", s4."LastKnownLatitude", s4."LastKnownLongitude", s4."LastLocationAt", s4."Phone", s4."SkillCategory", s4."TenantId0", s4."UpdatedAt0", s4."UserId", p0."AssetCategoryId", p0."AutoScheduleByDefault", p0."Category", p0."Code", p0."CreatedAt", p0."DefaultIntervalMonths", p0."DeletedAt", p0."DeletedByUserId", p0."Description", p0."EstimatedDurationHours", p0."IsActive", p0."IsPlatformSeed", p0."IsSystemTemplate", p0."Name", p0."OptionalReportSectionsJson", p0."SourceTemplateId", p0."TemplatePackId", p0."TenantId", p0."UpdatedAt", p0."Version", p0."WorkType", w5."Id", w5."AttachmentId", w5."CompletedAt", w5."CompletedByUserId", w5."CreatedAt", w5."DefaultValue", w5."EvidenceRequired", w5."FailureNote", w5."HelperText", w5."InputType", w5."IsCompleted", w5."IsRequired", w5."MaxValue", w5."MinValue", w5."NumberValue", w5."OptionsJson", w5."PmTemplateQuestionId", w5."QuestionText", w5."QuestionType", w5."Remarks", w5."RequiresNoteOnFail", w5."ResponseValue", w5."SectionName", w5."SectionOrder", w5."SortOrder", w5."TechnicianRemarksAllowed", w5."TenantId", w5."TextValue", w5."Unit", w5."UpdatedAt", w5."WorkOrderId"
      FROM work_orders AS w
      INNER JOIN (
          SELECT c."Id", c."ActiveDurationUnit", c."ActiveDurationValue", c."ActiveEndDate", c."ActiveStartDate", c."ClientName", c."ClientType", c."ContactPerson", c."ContactPhone", c."CreatedAt", c."CreditLimit", c."CurrentBalance", c."DefaultCreditTermId", c."Email", c."IsActive", c."Location", c."Notes", c."Phone", c."SlaDefinitionId", c."SlaPlan", c."TenantId", c."UpdatedAt"
          FROM clients AS c
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR c."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS c0 ON w."ClientId" = c0."Id"
      LEFT JOIN (
          SELECT a."Id", a."AssetCategoryId", a."AssetCode", a."AssetName", a."AssetType", a."AutoSchedulePm", a."BranchId", a."BuildingBlock", a."CapacityRating", a."ClientId", a."CommissioningDate", a."CreatedAt", a."CurrentMeterReading", a."DecommissionDate", a."DefaultAssignmentGroupId", a."FloorLevel", a."InstallationDate", a."LastPmDate", a."Location", a."LocationDescription", a."Manufacturer", a."MeterBuffer", a."MeterInterval", a."MeterLabel", a."Model", a."NextPmDate", a."Notes", a."OwnershipType", a."PhysicalDescription", a."PmFrequencyUnit", a."PmFrequencyValue", a."RecommendedPmFrequency", a."RoomArea", a."SerialNumber", a."SiteId", a."Status", a."SystemId", a."TenantId", a."UpdatedAt", a."WarrantyExpiryDate", a."YearOfManufacture"
          FROM assets AS a
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR a."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS a0 ON w."AssetId" = a0."Id"
      LEFT JOIN (
          SELECT a1."Id", a1."Code", a1."ContractorType", a1."CreatedAt", a1."DefaultServiceIntervalMonths", a1."Description", a1."DisplayOrder", a1."Icon", a1."IsActive", a1."IsDefault", a1."IsSystemTemplate", a1."Name", a1."ParentCategoryName", a1."SourceAssetCategoryId", a1."TemplatePackId", a1."TenantId", a1."UpdatedAt"
          FROM asset_categories AS a1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR a1."TenantId" = @ef_filter__CurrentTenantFilterId10
      ) AS a2 ON a0."AssetCategoryId" = a2."Id"
      LEFT JOIN (
          SELECT s."Id", s."AccessNotes", s."AlternateContact", s."AreaEstate", s."ClientId", s."ContactEmail", s."ContactPerson", s."ContactPhone", s."Country", s."County", s."CreatedAt", s."OperatingHours", s."Region", s."SiteCode", s."SiteName", s."SiteType", s."SpecialInstructions", s."Status", s."StreetAddress", s."TenantId", s."TownCity", s."UpdatedAt"
          FROM sites AS s
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR s."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s0 ON w."SiteId" = s0."Id"
      LEFT JOIN (
          SELECT s1."Id", s1."ClientId", s1."CreatedAt", s1."Description", s1."InstallationDate", s1."Manufacturer", s1."Model", s1."Notes", s1."SerialNumber", s1."SiteId", s1."Status", s1."SystemName", s1."SystemType", s1."TenantId", s1."UpdatedAt"
          FROM systems AS s1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR s1."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s2 ON w."SystemId" = s2."Id"
      LEFT JOIN (
          SELECT c1."Id", c1."AccountManagerUserId", c1."ActivatedAt", c1."AllowPreferentialRatesDuringGracePeriod", c1."AllowSlaDuringGracePeriod", c1."ApprovedAt", c1."AutoExpireEnabled", c1."BillingModel", c1."CancellationReason", c1."ClientId", c1."ContractNumber", c1."ContractType", c1."ContractValue", c1."CreatedAt", c1."Currency", c1."Description", c1."DurationMonths", c1."EndDate", c1."EscalationEmail", c1."ExcludedServices", c1."ExpiryCheckedAt", c1."GracePeriodAllowsSla", c1."GracePeriodDays", c1."GracePeriodPolicy", c1."IncludedServices", c1."InternalApproverUserId", c1."IsArchived", c1."LastReminderSentAt", c1."Name", c1."NextReminderAt", c1."Notes", c1."PauseSlaOnHold", c1."PriorityLevel", c1."RenewalBehavior", c1."RenewalNoticeDays", c1."RenewalOwnerUserId", c1."RenewalRisk", c1."RenewalStartedAt", c1."RenewedFromContractId", c1."RenewedToContractId", c1."ResolutionTimeHours", c1."ResponseTimeHours", c1."SlaMatrixJson", c1."StartDate", c1."Status", c1."SubmittedForApprovalAt", c1."SuspensionReason", c1."TenantId", c1."TerminationDate", c1."TerminationReason", c1."UpdatedAt", c1."WorkingHoursPolicy"
          FROM contracts AS c1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR c1."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS c2 ON w."ContractId" = c2."Id"
      LEFT JOIN (
          SELECT c3."Id", c3."ContractId", c3."CreatedAt", c3."Currency", c3."Description", c3."EffectiveFrom", c3."EffectiveTo", c3."IsActive", c3."IsDefault", c3."Name", c3."TenantId", c3."UpdatedAt"
          FROM contract_rate_cards AS c3
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR c3."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS c4 ON w."RateCardId" = c4."Id"
      LEFT JOIN (
          SELECT t."Id", t."ActiveWorkOrderId", t."AssignmentGroup", t."AvailabilityNote", t."AvailabilityStatus", t."AvailabilityUntil", t."AvailabilityUpdatedAt", t."BranchId", t."CreatedAt", t."Email", t."FullName", t."IsActive", t."IsTrackingActive", t."LastKnownLatitude", t."LastKnownLongitude", t."LastLocationAt", t."Phone", t."SkillCategory", t."TenantId", t."UpdatedAt", t."UserId"
          FROM technicians AS t
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR t."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS t0 ON w."AssignedTechnicianId" = t0."Id"
      LEFT JOIN (
          SELECT t1."Id", t1."ActiveWorkOrderId", t1."AssignmentGroup", t1."AvailabilityNote", t1."AvailabilityStatus", t1."AvailabilityUntil", t1."AvailabilityUpdatedAt", t1."BranchId", t1."CreatedAt", t1."Email", t1."FullName", t1."IsActive", t1."IsTrackingActive", t1."LastKnownLatitude", t1."LastKnownLongitude", t1."LastLocationAt", t1."Phone", t1."SkillCategory", t1."TenantId", t1."UpdatedAt", t1."UserId"
          FROM technicians AS t1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR t1."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS t2 ON w."LeadTechnicianId" = t2."Id"
      LEFT JOIN (
          SELECT a3."Id", a3."BranchId", a3."CreatedAt", a3."Description", a3."IsActive", a3."Name", a3."SkillArea", a3."TenantId", a3."UpdatedAt"
          FROM assignment_groups AS a3
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR a3."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS a4 ON w."AssignmentGroupId" = a4."Id"
      LEFT JOIN (
          SELECT b."Id", b."Address", b."Code", b."ContactPerson", b."CreatedAt", b."Email", b."IsActive", b."Location", b."Name", b."ParentBranchId", b."Phone", b."TenantId", b."UpdatedAt"
          FROM branches AS b
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR b."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS b0 ON w."BranchId" = b0."Id"
      LEFT JOIN (
          SELECT p."Id", p."AssetCategoryId", p."AutoScheduleByDefault", p."Category", p."Code", p."CreatedAt", p."DefaultIntervalMonths", p."DeletedAt", p."DeletedByUserId", p."Description", p."EstimatedDurationHours", p."IsActive", p."IsPlatformSeed", p."IsSystemTemplate", p."Name", p."OptionalReportSectionsJson", p."SourceTemplateId", p."TemplatePackId", p."TenantId", p."UpdatedAt", p."Version", p."WorkType"
          FROM pm_templates AS p
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR p."TenantId" = @ef_filter__CurrentTenantFilterId10
      ) AS p0 ON w."PmTemplateId" = p0."Id"
      LEFT JOIN (
          SELECT w0."Id", w0."AssignedAt", w0."AssignedByUserId", w0."AssignmentGroupId", w0."AssignmentStatus", w0."CreatedAt", w0."Notes", w0."TenantId", w0."UpdatedAt", w0."WorkOrderId", a6."Id" AS "Id0", a6."BranchId", a6."CreatedAt" AS "CreatedAt0", a6."Description", a6."IsActive", a6."Name", a6."SkillArea", a6."TenantId" AS "TenantId0", a6."UpdatedAt" AS "UpdatedAt0"
          FROM work_order_assignments AS w0
          LEFT JOIN (
              SELECT a5."Id", a5."BranchId", a5."CreatedAt", a5."Description", a5."IsActive", a5."Name", a5."SkillArea", a5."TenantId", a5."UpdatedAt"
              FROM assignment_groups AS a5
              WHERE @ef_filter__ShouldBypassTenantFilter2 OR a5."TenantId" = @ef_filter__CurrentTenantFilterId
          ) AS a6 ON w0."AssignmentGroupId" = a6."Id"
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR w0."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s3 ON w."Id" = s3."WorkOrderId"
      LEFT JOIN (
          SELECT w1."Id", w1."ActorUserId", w1."CreatedAt", w1."EventType", w1."Latitude", w1."Longitude", w1."Message", w1."NewStatus", w1."Note", w1."OccurredAt", w1."OldStatus", w1."Reason", w1."Status", w1."TenantId", w1."UpdatedAt", w1."WorkOrderId"
          FROM work_order_events AS w1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR w1."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS w4 ON w."Id" = w4."WorkOrderId"
      LEFT JOIN (
          SELECT w2."Id", w2."AcceptedAt", w2."ArrivalAt", w2."AssignedAt", w2."AssignedByUserId", w2."CreatedAt", w2."DeclinedAt", w2."DepartureAt", w2."IsLead", w2."Notes", w2."Status", w2."TechnicianId", w2."TenantId", w2."UpdatedAt", w2."WorkOrderId", t4."Id" AS "Id0", t4."ActiveWorkOrderId", t4."AssignmentGroup", t4."AvailabilityNote", t4."AvailabilityStatus", t4."AvailabilityUntil", t4."AvailabilityUpdatedAt", t4."BranchId", t4."CreatedAt" AS "CreatedAt0", t4."Email", t4."FullName", t4."IsActive", t4."IsTrackingActive", t4."LastKnownLatitude", t4."LastKnownLongitude", t4."LastLocationAt", t4."Phone", t4."SkillCategory", t4."TenantId" AS "TenantId0", t4."UpdatedAt" AS "UpdatedAt0", t4."UserId"
          FROM work_order_technician_assignments AS w2
          INNER JOIN (
              SELECT t3."Id", t3."ActiveWorkOrderId", t3."AssignmentGroup", t3."AvailabilityNote", t3."AvailabilityStatus", t3."AvailabilityUntil", t3."AvailabilityUpdatedAt", t3."BranchId", t3."CreatedAt", t3."Email", t3."FullName", t3."IsActive", t3."IsTrackingActive", t3."LastKnownLatitude", t3."LastKnownLongitude", t3."LastLocationAt", t3."Phone", t3."SkillCategory", t3."TenantId", t3."UpdatedAt", t3."UserId"
              FROM technicians AS t3
              WHERE @ef_filter__ShouldBypassTenantFilter2 OR t3."TenantId" = @ef_filter__CurrentTenantFilterId
          ) AS t4 ON w2."TechnicianId" = t4."Id"
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR w2."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s4 ON w."Id" = s4."WorkOrderId"
      LEFT JOIN (
          SELECT w3."Id", w3."AttachmentId", w3."CompletedAt", w3."CompletedByUserId", w3."CreatedAt", w3."DefaultValue", w3."EvidenceRequired", w3."FailureNote", w3."HelperText", w3."InputType", w3."IsCompleted", w3."IsRequired", w3."MaxValue", w3."MinValue", w3."NumberValue", w3."OptionsJson", w3."PmTemplateQuestionId", w3."QuestionText", w3."QuestionType", w3."Remarks", w3."RequiresNoteOnFail", w3."ResponseValue", w3."SectionName", w3."SectionOrder", w3."SortOrder", w3."TechnicianRemarksAllowed", w3."TenantId", w3."TextValue", w3."Unit", w3."UpdatedAt", w3."WorkOrderId"
          FROM work_order_checklist_items AS w3
