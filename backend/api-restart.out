      Executed DbCommand (3ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @TenantId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT a."Id", a."Code", a."ContractorType", a."CreatedAt", a."DefaultServiceIntervalMonths", a."Description", a."DisplayOrder", a."Icon", a."IsActive", a."IsDefault", a."IsSystemTemplate", a."Name", a."ParentCategoryName", a."SourceAssetCategoryId", a."TemplatePackId", a."TenantId", a."UpdatedAt", a0."Id", a0."AssetCategoryId", a0."CreatedAt", a0."DisplayOrder", a0."DropdownOptions", a0."FieldLabel", a0."FieldName", a0."FieldType", a0."HelpText", a0."IsActive", a0."IsRequired", a0."Unit", a0."UpdatedAt"
      FROM asset_categories AS a
      LEFT JOIN asset_category_fields AS a0 ON a."Id" = a0."AssetCategoryId"
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR a."TenantId" = @ef_filter__CurrentTenantFilterId) AND a."TenantId" = @TenantId AND a."IsActive"
      ORDER BY a."ParentCategoryName", a."DisplayOrder", a."Name", a."Id"
