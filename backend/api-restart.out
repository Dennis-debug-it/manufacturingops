      SELECT s."Id", s."CreatedAt", s."DefaultBranchId", s."Department", s."Email", s."FailedLoginCount", s."FullName", s."HasAllBranchAccess", s."InviteAcceptedAt", s."InviteTokenExpiresAt", s."InviteTokenHash", s."IsActive", s."JobTitle", s."LastCredentialSentAt", s."LastFailedLoginAt", s."LockedOutUntil", s."MustChangePassword", s."PasswordHash", s."Phone", s."Role", s."TenantId", s."UpdatedAt", s."Id0", s."Address", s."City", s."CompanyName", s."ContactEmail", s."ContactName", s."ContactPhone", s."Country", s."County", s."CreatedAt0", s."CreatedByUserId", s."DeactivatedAt", s."DeactivatedByUserId", s."DeactivationReason", s."Email0", s."Industry", s."IsActive0", s."LegalName", s."LicenseStatus", s."LogoUrl", s."MaxBranches", s."MaxUsers", s."Name", s."Phone0", s."PhysicalAddress", s."PlanName", s."PostalAddress", s."PrimaryColor", s."RegistrationNumber", s."ReportTemplateConfigJson", s."SecondaryColor", s."ShowPoweredByEcosys", s."Slug", s."Status", s."SubscriptionEndsAt", s."SubscriptionStartsAt", s."SuspendedAt", s."TaxPin", s."TradingName", s."TrialEndsAt", s."TrialExtendedAt", s."TrialExtendedByUserId", s."TrialExtensionUsed", s."TrialStartsAt", s."UpdatedAt0", s."UpdatedByUserId", s."VatNumber", s."Website", s."Id1", s."CanApproveMaterials", s."CanAssignWorkOrders", s."CanCompleteWorkOrders", s."CanCreateWorkOrders", s."CanIssueMaterials", s."CanManageAssets", s."CanManageBillableWork", s."CanManageFinance", s."CanManageFinanceApprovals", s."CanManageFinanceRates", s."CanManageKnowledge", s."CanManageMaterials", s."CanManageSettings", s."CanOverrideMaterialStock", s."CanRequestMaterials", s."CanViewBillableWork", s."CanViewFinance", s."CanViewFinanceApprovals", s."CanViewFinanceRates", s."CanViewKnowledge", s."CanViewMaterials", s."CanViewReports", s."CanViewWorkOrders", s."CreatedAt1", s."UpdatedAt1", s."UserId", u2."Id", u2."BranchId", u2."CreatedAt", u2."IsDefault", u2."TenantId", u2."UpdatedAt", u2."UserId"
      FROM (
          SELECT u."Id", u."CreatedAt", u."DefaultBranchId", u."Department", u."Email", u."FailedLoginCount", u."FullName", u."HasAllBranchAccess", u."InviteAcceptedAt", u."InviteTokenExpiresAt", u."InviteTokenHash", u."IsActive", u."JobTitle", u."LastCredentialSentAt", u."LastFailedLoginAt", u."LockedOutUntil", u."MustChangePassword", u."PasswordHash", u."Phone", u."Role", u."TenantId", u."UpdatedAt", t."Id" AS "Id0", t."Address", t."City", t."CompanyName", t."ContactEmail", t."ContactName", t."ContactPhone", t."Country", t."County", t."CreatedAt" AS "CreatedAt0", t."CreatedByUserId", t."DeactivatedAt", t."DeactivatedByUserId", t."DeactivationReason", t."Email" AS "Email0", t."Industry", t."IsActive" AS "IsActive0", t."LegalName", t."LicenseStatus", t."LogoUrl", t."MaxBranches", t."MaxUsers", t."Name", t."Phone" AS "Phone0", t."PhysicalAddress", t."PlanName", t."PostalAddress", t."PrimaryColor", t."RegistrationNumber", t."ReportTemplateConfigJson", t."SecondaryColor", t."ShowPoweredByEcosys", t."Slug", t."Status", t."SubscriptionEndsAt", t."SubscriptionStartsAt", t."SuspendedAt", t."TaxPin", t."TradingName", t."TrialEndsAt", t."TrialExtendedAt", t."TrialExtendedByUserId", t."TrialExtensionUsed", t."TrialStartsAt", t."UpdatedAt" AS "UpdatedAt0", t."UpdatedByUserId", t."VatNumber", t."Website", u0."Id" AS "Id1", u0."CanApproveMaterials", u0."CanAssignWorkOrders", u0."CanCompleteWorkOrders", u0."CanCreateWorkOrders", u0."CanIssueMaterials", u0."CanManageAssets", u0."CanManageBillableWork", u0."CanManageFinance", u0."CanManageFinanceApprovals", u0."CanManageFinanceRates", u0."CanManageKnowledge", u0."CanManageMaterials", u0."CanManageSettings", u0."CanOverrideMaterialStock", u0."CanRequestMaterials", u0."CanViewBillableWork", u0."CanViewFinance", u0."CanViewFinanceApprovals", u0."CanViewFinanceRates", u0."CanViewKnowledge", u0."CanViewMaterials", u0."CanViewReports", u0."CanViewWorkOrders", u0."CreatedAt" AS "CreatedAt1", u0."UpdatedAt" AS "UpdatedAt1", u0."UserId"
          FROM users AS u
          INNER JOIN tenants AS t ON u."TenantId" = t."Id"
          LEFT JOIN user_permissions AS u0 ON u."Id" = u0."UserId"
          WHERE (@ef_filter__ShouldBypassTenantFilter2 OR u."TenantId" = @ef_filter__CurrentTenantFilterId) AND u."Id" = @userId
          LIMIT 2
      ) AS s
      LEFT JOIN (
          SELECT u1."Id", u1."BranchId", u1."CreatedAt", u1."IsDefault", u1."TenantId", u1."UpdatedAt", u1."UserId"
          FROM user_branch_assignments AS u1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR u1."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS u2 ON s."Id" = u2."UserId"
      ORDER BY s."Id", s."Id0", s."Id1"
