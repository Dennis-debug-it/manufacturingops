          SELECT w."Id", w."AcknowledgedByName", w."AcknowledgementComments", w."AcknowledgementDate", w."ActualDuration", w."AppliedRateSource", w."AppliedResolutionHours", w."AppliedResponseHours", w."AppliedSlaSource", w."ArrivalAt", w."AssetId", w."AssignedTechnicianId", w."AssignedTechnicianIdsJson", w."AssignmentGroupId", w."AssignmentType", w."BillingModel", w."BillingStatus", w."BranchId", w."ClientContactEmail", w."ClientId", w."ClosedAt", w."ClosedByUserId", w."CompletedAt", w."ContractId", w."ContractSnapshotJson", w."CoverageStatus", w."CreatedAt", w."DepartureAt", w."Description", w."DueDate", w."EstimatedCharge", w."EstimatedDuration", w."EstimatedLabourHours", w."EstimatedMaterialCost", w."FinalCharge", w."HoldEndedAt", w."HoldNote", w."HoldReason", w."HoldStartedAt", w."IsBillable", w."IsPreventiveMaintenance", w."JobCardNotes", w."LeadTechnicianId", w."NotifyClient", w."PmTemplateId", w."PmTemplateNameSnapshot", w."PmTemplateVersionSnapshot", w."PreventiveMaintenancePlanId", w."PricingNotes", w."PricingSnapshotJson", w."PricingStatus", w."Priority", w."RateCardId", w."ScheduledEndAt", w."ScheduledStartAt", w."ServiceType", w."SiteId", w."SlaResolutionBreached", w."SlaResolutionBreachedAt", w."SlaResolutionDeadline", w."SlaResponseBreached", w."SlaResponseBreachedAt", w."SlaResponseDeadline", w."SlaSnapshotJson", w."Status", w."SystemId", w."TenantId", w."Title", w."UpdatedAt", w."WorkDoneNotes", w."WorkOrderNumber", w."WorkStartedAt", w."WorkType"
          FROM work_orders AS w
