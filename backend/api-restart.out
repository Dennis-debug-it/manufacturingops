      Executed DbCommand (22ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
