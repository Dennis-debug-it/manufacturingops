      FROM (
          SELECT u."Id", u."CreatedAt", u."DefaultBranchId", u."Department", u."Email", u."FailedLoginCount", u."FullName", u."HasAllBranchAccess", u."InviteAcceptedAt", u."InviteTokenExpiresAt", u."InviteTokenHash", u."IsActive", u."JobTitle", u."LastCredentialSentAt", u."LastFailedLoginAt", u."LockedOutUntil", u."MustChangePassword", u."PasswordHash", u."Phone", u."Role", u."TenantId", u."UpdatedAt", t."Id" AS "Id0", t."Address", t."City", t."CompanyName", t."ContactEmail", t."ContactName", t."ContactPhone", t."Country", t."County", t."CreatedAt" AS "CreatedAt0", t."CreatedByUserId", t."DeactivatedAt", t."DeactivatedByUserId", t."DeactivationReason", t."Email" AS "Email0", t."Industry", t."IsActive" AS "IsActive0", t."LegalName", t."LicenseStatus", t."LogoUrl", t."MaxBranches", t."MaxUsers", t."Name", t."Phone" AS "Phone0", t."PhysicalAddress", t."PlanName", t."PostalAddress", t."PrimaryColor", t."RegistrationNumber", t."ReportTemplateConfigJson", t."SecondaryColor", t."ShowPoweredByEcosys", t."Slug", t."Status", t."SubscriptionEndsAt", t."SubscriptionStartsAt", t."SuspendedAt", t."TaxPin", t."TradingName", t."TrialEndsAt", t."TrialExtendedAt", t."TrialExtendedByUserId", t."TrialExtensionUsed", t."TrialStartsAt", t."UpdatedAt" AS "UpdatedAt0", t."UpdatedByUserId", t."VatNumber", t."Website", u0."Id" AS "Id1", u0."CanApproveMaterials", u0."CanAssignWorkOrders", u0."CanCompleteWorkOrders", u0."CanCreateWorkOrders", u0."CanIssueMaterials", u0."CanManageAssets", u0."CanManageBillableWork", u0."CanManageFinance", u0."CanManageFinanceApprovals", u0."CanManageFinanceRates", u0."CanManageKnowledge", u0."CanManageMaterials", u0."CanManageSettings", u0."CanOverrideMaterialStock", u0."CanRequestMaterials", u0."CanViewBillableWork", u0."CanViewFinance", u0."CanViewFinanceApprovals", u0."CanViewFinanceRates", u0."CanViewKnowledge", u0."CanViewMaterials", u0."CanViewReports", u0."CanViewWorkOrders", u0."CreatedAt" AS "CreatedAt1", u0."UpdatedAt" AS "UpdatedAt1", u0."UserId"
          FROM users AS u
          INNER JOIN tenants AS t ON u."TenantId" = t."Id"
          LEFT JOIN user_permissions AS u0 ON u."Id" = u0."UserId"
          WHERE (@ef_filter__ShouldBypassTenantFilter2 OR u."TenantId" = @ef_filter__CurrentTenantFilterId) AND u."Id" = @userId
