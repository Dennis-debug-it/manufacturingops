info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @tenantId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT t."Id", t."AdvancedReportsOverride", t."BillingCycle", t."CancelledAt", t."ClientPortalOverride", t."CreatedAt", t."EmailIngestionOverride", t."ExpiresAt", t."GracePeriodDays", t."LicensePlanId", t."MaxAssetsOverride", t."MaxBranchesOverride", t."MaxUsersOverride", t."MonitoringIntegrationOverride", t."MonthlyWorkOrdersOverride", t."NextBillingDate", t."Notes", t."StartsAt", t."Status", t."SuspendedAt", t."TenantId", t."TrialEndsAt", t."UpdatedAt", l."Id", l."AdvancedReports", l."AnnualPrice", l."ClientPortal", l."CreatedAt", l."DisplayName", l."EmailIngestion", l."IsActive", l."MaxAssets", l."MaxBranches", l."MaxUsers", l."ModulesIncluded", l."MonitoringIntegration", l."MonthlyPrice", l."MonthlyWorkOrders", l."PlanCode", l."UpdatedAt"
      FROM tenant_licenses AS t
      INNER JOIN license_plans AS l ON t."LicensePlanId" = l."Id"
