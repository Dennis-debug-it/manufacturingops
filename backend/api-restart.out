      Executed DbCommand (3ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @tenantId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
