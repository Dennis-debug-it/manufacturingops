info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (76ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT w."Id"
      FROM work_orders AS w
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR w."TenantId" = @ef_filter__CurrentTenantFilterId) AND (w."SlaResponseDeadline" IS NOT NULL OR w."SlaResolutionDeadline" IS NOT NULL) AND w."Status" NOT IN ('Closed', 'Cancelled')
