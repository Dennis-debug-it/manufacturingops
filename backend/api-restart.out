      FROM assignment_groups AS a
      LEFT JOIN (
          SELECT b."Id", b."Address", b."Code", b."ContactPerson", b."CreatedAt", b."Email", b."IsActive", b."Location", b."Name", b."ParentBranchId", b."Phone", b."TenantId", b."UpdatedAt"
          FROM branches AS b
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR b."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS b0 ON a."BranchId" = b0."Id"
      LEFT JOIN (
          SELECT a0."Id", a0."AddedAt", a0."AssignmentGroupId", a0."CreatedAt", a0."IsActive", a0."IsLead", a0."TechnicianId", a0."TenantId", a0."UpdatedAt", t0."Id" AS "Id0", t0."ActiveWorkOrderId", t0."AssignmentGroup", t0."AvailabilityNote", t0."AvailabilityStatus", t0."AvailabilityUntil", t0."AvailabilityUpdatedAt", t0."BranchId", t0."CreatedAt" AS "CreatedAt0", t0."Email", t0."FullName", t0."IsActive" AS "IsActive0", t0."IsTrackingActive", t0."LastKnownLatitude", t0."LastKnownLongitude", t0."LastLocationAt", t0."Phone", t0."SkillCategory", t0."TenantId" AS "TenantId0", t0."UpdatedAt" AS "UpdatedAt0", t0."UserId", u0."Id" AS "Id1", u0."CreatedAt" AS "CreatedAt1", u0."DefaultBranchId", u0."Department", u0."Email" AS "Email0", u0."FailedLoginCount", u0."FullName" AS "FullName0", u0."HasAllBranchAccess", u0."InviteAcceptedAt", u0."InviteTokenExpiresAt", u0."InviteTokenHash", u0."IsActive" AS "IsActive1", u0."JobTitle", u0."LastCredentialSentAt", u0."LastFailedLoginAt", u0."LockedOutUntil", u0."MustChangePassword", u0."PasswordHash", u0."Phone" AS "Phone0", u0."Role", u0."TenantId" AS "TenantId1", u0."UpdatedAt" AS "UpdatedAt1"
          FROM assignment_group_members AS a0
          INNER JOIN (
              SELECT t."Id", t."ActiveWorkOrderId", t."AssignmentGroup", t."AvailabilityNote", t."AvailabilityStatus", t."AvailabilityUntil", t."AvailabilityUpdatedAt", t."BranchId", t."CreatedAt", t."Email", t."FullName", t."IsActive", t."IsTrackingActive", t."LastKnownLatitude", t."LastKnownLongitude", t."LastLocationAt", t."Phone", t."SkillCategory", t."TenantId", t."UpdatedAt", t."UserId"
              FROM technicians AS t
              WHERE @ef_filter__ShouldBypassTenantFilter2 OR t."TenantId" = @ef_filter__CurrentTenantFilterId
          ) AS t0 ON a0."TechnicianId" = t0."Id"
          LEFT JOIN (
              SELECT u."Id", u."CreatedAt", u."DefaultBranchId", u."Department", u."Email", u."FailedLoginCount", u."FullName", u."HasAllBranchAccess", u."InviteAcceptedAt", u."InviteTokenExpiresAt", u."InviteTokenHash", u."IsActive", u."JobTitle", u."LastCredentialSentAt", u."LastFailedLoginAt", u."LockedOutUntil", u."MustChangePassword", u."PasswordHash", u."Phone", u."Role", u."TenantId", u."UpdatedAt"
              FROM users AS u
              WHERE @ef_filter__ShouldBypassTenantFilter2 OR u."TenantId" = @ef_filter__CurrentTenantFilterId
          ) AS u0 ON t0."UserId" = u0."Id"
          WHERE (@ef_filter__ShouldBypassTenantFilter2 OR a0."TenantId" = @ef_filter__CurrentTenantFilterId) AND a0."IsActive"
      ) AS s ON a."Id" = s."AssignmentGroupId"
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR a."TenantId" = @ef_filter__CurrentTenantFilterId) AND a."TenantId" = @TenantId
