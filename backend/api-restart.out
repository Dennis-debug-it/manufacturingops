info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (2ms) [Parameters=[@ef_filter__ShouldBypassTenantFilter2='?' (DbType = Boolean), @ef_filter__CurrentTenantFilterId='?' (DbType = Guid), @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id"
      FROM scheduled_reports AS s
