      ) AS u4 ON m."ApprovedByUserId" = u4."Id"
      LEFT JOIN (
          SELECT u5."Id", u5."CreatedAt", u5."DefaultBranchId", u5."Department", u5."Email", u5."FailedLoginCount", u5."FullName", u5."HasAllBranchAccess", u5."InviteAcceptedAt", u5."InviteTokenExpiresAt", u5."InviteTokenHash", u5."IsActive", u5."JobTitle", u5."LastCredentialSentAt", u5."LastFailedLoginAt", u5."LockedOutUntil", u5."MustChangePassword", u5."PasswordHash", u5."Phone", u5."Role", u5."TenantId", u5."UpdatedAt"
          FROM users AS u5
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR u5."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS u6 ON m."IssuedToUserId" = u6."Id"
      LEFT JOIN (
          SELECT m0."Id", m0."CreatedAt", m0."MaterialIssueId", m0."MaterialItemId", m0."Notes", m0."QuantityIssued", m0."QuantityRequested", m0."QuantityReturned", m0."TenantId", m0."Unit", m0."UnitCost", m0."UpdatedAt", m2."Id" AS "Id0", m2."Category", m2."CreatedAt" AS "CreatedAt0", m2."IsActive", m2."ItemCode", m2."ItemName", m2."QuantityOnHand", m2."ReorderLevel", m2."TenantId" AS "TenantId0", m2."UnitCost" AS "UnitCost0", m2."UnitOfMeasure", m2."UpdatedAt" AS "UpdatedAt0"
          FROM material_issue_lines AS m0
          INNER JOIN (
              SELECT m1."Id", m1."Category", m1."CreatedAt", m1."IsActive", m1."ItemCode", m1."ItemName", m1."QuantityOnHand", m1."ReorderLevel", m1."TenantId", m1."UnitCost", m1."UnitOfMeasure", m1."UpdatedAt"
              FROM material_items AS m1
              WHERE @ef_filter__ShouldBypassTenantFilter2 OR m1."TenantId" = @ef_filter__CurrentTenantFilterId
          ) AS m2 ON m0."MaterialItemId" = m2."Id"
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR m0."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s3 ON m."Id" = s3."MaterialIssueId"
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR m."TenantId" = @ef_filter__CurrentTenantFilterId) AND m."TenantId" = @TenantId AND m."BranchId" = '10000000-0000-0000-0000-000000000010'
      ORDER BY m."CreatedAt" DESC, m."Id", b0."Id", w0."Id", a0."Id", c0."Id", s0."Id", s2."Id", u0."Id", u2."Id", u4."Id", u6."Id", s3."Id"
