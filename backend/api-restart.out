      SELECT n."Id", n."BranchId", n."CreatedAt", n."DocumentType", n."IncludeMonth", n."IncludeYear", n."IsActive", n."IsLocked", n."LastResetAt", n."NextNumber", n."PaddingLength", n."Prefix", n."ResetFrequency", n."Separator", n."Suffix", n."TenantId", n."UpdatedAt", n."YearFormat", b0."Id", b0."Address", b0."Code", b0."ContactPerson", b0."CreatedAt", b0."Email", b0."IsActive", b0."Location", b0."Name", b0."ParentBranchId", b0."Phone", b0."TenantId", b0."UpdatedAt"
      FROM numbering_settings AS n
      LEFT JOIN (
          SELECT b."Id", b."Address", b."Code", b."ContactPerson", b."CreatedAt", b."Email", b."IsActive", b."Location", b."Name", b."ParentBranchId", b."Phone", b."TenantId", b."UpdatedAt"
          FROM branches AS b
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR b."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS b0 ON n."BranchId" = b0."Id"
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR n."TenantId" = @ef_filter__CurrentTenantFilterId) AND n."TenantId" = @TenantId AND n."BranchId" IS NULL
      ORDER BY n."DocumentType"
