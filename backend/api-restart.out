      LEFT JOIN (
          SELECT u5."Id", u5."CreatedAt", u5."DefaultBranchId", u5."Department", u5."Email", u5."FailedLoginCount", u5."FullName", u5."HasAllBranchAccess", u5."InviteAcceptedAt", u5."InviteTokenExpiresAt", u5."InviteTokenHash", u5."IsActive", u5."JobTitle", u5."LastCredentialSentAt", u5."LastFailedLoginAt", u5."LockedOutUntil", u5."MustChangePassword", u5."PasswordHash", u5."Phone", u5."Role", u5."TenantId", u5."UpdatedAt"
