          FROM systems AS s1
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR s1."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s2 ON a."SystemId" = s2."Id"
      LEFT JOIN (
          SELECT a0."Id", a0."Code", a0."ContractorType", a0."CreatedAt", a0."DefaultServiceIntervalMonths", a0."Description", a0."DisplayOrder", a0."Icon", a0."IsActive", a0."IsDefault", a0."IsSystemTemplate", a0."Name", a0."ParentCategoryName", a0."SourceAssetCategoryId", a0."TemplatePackId", a0."TenantId", a0."UpdatedAt"
          FROM asset_categories AS a0
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR a0."TenantId" = @ef_filter__CurrentTenantFilterId16
      ) AS a1 ON a."AssetCategoryId" = a1."Id"
      LEFT JOIN (
          SELECT a2."Id", a2."AssetId", a2."CreatedAt", a2."FieldDefinitionId", a2."TenantId", a2."UpdatedAt", a2."Value", a3."Id" AS "Id0", a3."AssetCategoryId", a3."CreatedAt" AS "CreatedAt0", a3."DisplayOrder", a3."DropdownOptions", a3."FieldLabel", a3."FieldName", a3."FieldType", a3."HelpText", a3."IsActive", a3."IsRequired", a3."Unit", a3."UpdatedAt" AS "UpdatedAt0"
          FROM asset_custom_field_values AS a2
          INNER JOIN asset_category_fields AS a3 ON a2."FieldDefinitionId" = a3."Id"
          WHERE @ef_filter__ShouldBypassTenantFilter2 OR a2."TenantId" = @ef_filter__CurrentTenantFilterId
      ) AS s3 ON a."Id" = s3."AssetId"
      WHERE (@ef_filter__ShouldBypassTenantFilter2 OR a."TenantId" = @ef_filter__CurrentTenantFilterId) AND a."TenantId" = @TenantId AND (a."BranchId" IS NULL OR a."BranchId" = '10000000-0000-0000-0000-000000000010') AND a."Status" <> 'Inactive'
      ORDER BY a."AssetName", a."Id", c0."Id", b0."Id", s0."Id", s2."Id", a1."Id", s3."Id"
