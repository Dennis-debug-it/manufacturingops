{
  "ConnectionStrings": {
    "DefaultConnection": "SET_IN_ENV"
  },
  "Jwt": {
    "Issuer": "Ecosys",
    "Audience": "Ecosys.Clients",
    "SigningKey": "SET_IN_ENV",
    "ExpiryMinutes": 30,
    "RefreshTokenDays": 1,
    "RefreshTokenRememberMeDays": 30
  },
  "Smtp": {
    "Host": "",
    "Port": 25,
    "UseSsl": false,
    "Username": "",
    "Password": ""
  },
  "PlatformAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "Platform SuperAdmin"
  },
  "AuthSecurity": {
    "FailedLoginThreshold": 5,
    "LockoutMinutes": 15,
    "RateLimitPermitLimit": 20,
    "RateLimitWindowSeconds": 60,
    "RateLimitQueueLimit": 0,
    "PasswordResetLifetimeMinutes": 120,
    "InvitationLifetimeHours": 72
  },
  "Time": {
    "DefaultTimeZone": "Africa/Nairobi"
  },
  "App": {
    "PublicUrl": "http://localhost"
  },
  "Features": {
    "WhatsApp": false,
    "EmailIntake": false
  },
  "WhatsApp": {
    "Enabled": false,
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "AccessToken": "",
    "AppSecret": "",
    "WebhookVerifyToken": "",
    "GraphApiVersion": "v21.0",
    "BaseUrl": "https://graph.facebook.com",
    "MonthlyCapPerTenant": 1000,
    "DisplayPhoneNumber": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*"
}
