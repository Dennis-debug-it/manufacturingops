using System.Text.Json;
using Ecosys.Domain.Entities;
using Ecosys.Infrastructure.Data;
using Ecosys.Shared.Errors;
using Microsoft.EntityFrameworkCore;

namespace Ecosys.Infrastructure.Services;

public sealed record StarterPackSummary(
    Guid Id,
    string Name,
    string Code,
    string? Description,
    string ContractorType,
    bool IsActive,
    int Version,
    bool IsInstalled,
    string? InstallationStatus,
    IReadOnlyCollection<StarterPackAssetCategorySummary> AssetCategories,
    IReadOnlyCollection<StarterPackChecklistSummary> ChecklistTemplates);

public sealed record StarterPackAssetCategorySummary(
    Guid Id,
    string Name,
    string? Code,
    string? Description,
    int SortOrder,
    int? DefaultServiceIntervalMonths,
    int FieldCount);

public sealed record StarterPackChecklistSummary(
    Guid Id,
    string Name,
    string? Code,
    string WorkType,
    int? DefaultIntervalMonths,
    int SectionCount,
    int ItemCount);

public interface IStarterPackService
{
    Task EnsureSystemStarterPacksSeededAsync(CancellationToken cancellationToken = default);
    Task<IReadOnlyCollection<StarterPackSummary>> ListStarterPacksAsync(Guid? tenantId = null, CancellationToken cancellationToken = default);
    Task<StarterPackSummary> InstallStarterPackAsync(Guid tenantId, Guid starterPackId, Guid? actorUserId = null, CancellationToken cancellationToken = default);
}

internal sealed class StarterPackService(AppDbContext dbContext) : IStarterPackService
{
    private const string PreventiveMaintenance = "PreventiveMaintenance";
    private const string BreakdownCorrective = "BreakdownCorrective";

    public async Task EnsureSystemStarterPacksSeededAsync(CancellationToken cancellationToken = default)
    {
        var definitions = BuildDefinitions();
        var existingPacks = await dbContext.SystemTemplatePacks
            .Include(x => x.AssetCategories)
                .ThenInclude(x => x.Fields)
            .Include(x => x.ChecklistTemplates)
                .ThenInclude(x => x.Sections)
            .Include(x => x.ChecklistTemplates)
                .ThenInclude(x => x.Questions)
            .ToListAsync(cancellationToken);

        var alreadySeeded = definitions.All(definition =>
            existingPacks.Any(pack =>
                pack.IsSystem
                && Matches(pack.Code, definition.Code)
                && pack.Version == definition.Version
                && pack.AssetCategories.Any(category => category.TenantId == null && category.IsSystemTemplate)
                && pack.ChecklistTemplates.Any(template => template.TenantId == null && template.IsSystemTemplate)));

        if (alreadySeeded)
        {
            return;
        }

        foreach (var definition in definitions)
        {
            var pack = existingPacks.SingleOrDefault(x => x.Code == definition.Code);
            if (pack is null)
            {
                pack = new SystemTemplatePack();
                dbContext.SystemTemplatePacks.Add(pack);
                existingPacks.Add(pack);
            }

            pack.Name = definition.Name;
            pack.Code = definition.Code;
            pack.Description = definition.Description;
            pack.ContractorType = definition.ContractorType;
            pack.IsSystem = true;
            pack.IsActive = true;
            pack.Version = definition.Version;

            foreach (var obsoleteCategory in pack.AssetCategories.Where(x => x.TenantId == null && definition.AssetCategories.All(d => !Matches(d.Code, x.Code))).ToList())
            {
                dbContext.AssetCategoryFields.RemoveRange(obsoleteCategory.Fields);
                dbContext.AssetCategories.Remove(obsoleteCategory);
            }

            foreach (var categoryDefinition in definition.AssetCategories)
            {
                var category = pack.AssetCategories.SingleOrDefault(x => x.TenantId == null && Matches(categoryDefinition.Code, x.Code));
                if (category is null)
                {
                    category = new AssetCategory();
                    pack.AssetCategories.Add(category);
                }

                category.TenantId = null;
                category.TemplatePack = pack;
                category.SourceAssetCategoryId = null;
                category.Name = categoryDefinition.Name;
                category.Code = categoryDefinition.Code;
                category.Description = categoryDefinition.Description;
                category.ContractorType = definition.ContractorType;
                category.ParentCategoryName = categoryDefinition.ParentCategoryName;
                category.Icon = "tool";
                category.IsDefault = false;
                category.IsActive = true;
                category.IsSystemTemplate = true;
                category.DefaultServiceIntervalMonths = categoryDefinition.DefaultIntervalMonths;
                category.DisplayOrder = categoryDefinition.SortOrder;

                dbContext.AssetCategoryFields.RemoveRange(category.Fields);
                category.Fields = categoryDefinition.Fields
                    .Select((x, index) => new AssetCategoryField
                    {
                        FieldName = x.FieldKey,
                        FieldLabel = x.Label,
                        FieldType = x.FieldType,
                        DropdownOptions = x.Options?.Count > 0 ? string.Join(',', x.Options) : null,
                        Unit = x.Unit,
                        HelpText = x.HelpText,
                        IsRequired = x.IsRequired,
                        IsActive = x.IsActive,
                        DisplayOrder = index + 1
                    })
                    .ToList();
            }

            foreach (var obsoleteTemplate in pack.ChecklistTemplates.Where(x => x.TenantId == null && definition.Checklists.All(d => !Matches(d.Code, x.Code))).ToList())
            {
                dbContext.PmTemplateQuestions.RemoveRange(obsoleteTemplate.Questions);
                dbContext.PmTemplateSections.RemoveRange(obsoleteTemplate.Sections);
                dbContext.PmTemplates.Remove(obsoleteTemplate);
            }

            foreach (var checklistDefinition in definition.Checklists)
            {
                var template = pack.ChecklistTemplates.SingleOrDefault(x => x.TenantId == null && Matches(checklistDefinition.Code, x.Code));
                if (template is null)
                {
                    template = new PmTemplate();
                    pack.ChecklistTemplates.Add(template);
                }

                template.TenantId = null;
                template.TemplatePack = pack;
                template.SourceTemplateId = null;
                template.AssetCategoryId = null;
                template.Category = checklistDefinition.Category;
                template.Name = checklistDefinition.Name;
                template.Code = checklistDefinition.Code;
                template.Description = checklistDefinition.Description;
                template.WorkType = checklistDefinition.WorkType;
                template.DefaultIntervalMonths = checklistDefinition.DefaultIntervalMonths;
                template.AutoScheduleByDefault = false;
                template.IsActive = true;
                template.IsPlatformSeed = true;
                template.IsSystemTemplate = true;
                template.Version = definition.Version;
                template.OptionalReportSectionsJson = checklistDefinition.OptionalReportSections?.Count > 0
                    ? JsonSerializer.Serialize(checklistDefinition.OptionalReportSections)
                    : null;

                dbContext.PmTemplateQuestions.RemoveRange(template.Questions);
                dbContext.PmTemplateSections.RemoveRange(template.Sections);

                var sections = checklistDefinition.Sections
                    .OrderBy(x => x.SortOrder)
                    .Select(x => new PmTemplateSection
                    {
                        SectionName = x.Title,
                        Description = x.Description,
                        DisplayOrder = x.SortOrder,
                        IsActive = x.IsActive
                    })
                    .ToList();

                var sectionMap = sections.ToDictionary(x => x.SectionName, StringComparer.OrdinalIgnoreCase);
                template.Sections = sections;
                template.Questions = checklistDefinition.Sections
                    .OrderBy(x => x.SortOrder)
                    .SelectMany(section => section.Items.OrderBy(item => item.SortOrder).Select((item, itemIndex) => new PmTemplateQuestion
                    {
                        Section = sectionMap[section.Title],
                        SectionName = section.Title,
                        Prompt = item.Label,
                        HelperText = item.HelpText,
                        ResponseType = item.InputType,
                        Unit = item.Unit,
                        DefaultValue = null,
                        IsRequired = item.IsRequired,
                        EvidenceRequired = item.InputType.Equals("photo", StringComparison.OrdinalIgnoreCase),
                        TechnicianRemarksAllowed = true,
                        RequiresNoteOnFail = false,
                        IsActive = item.IsActive,
                        DisplayOrder = itemIndex + 1,
                        OptionsJson = item.Options?.Count > 0 ? JsonSerializer.Serialize(item.Options) : null
                    }))
                    .ToList();
            }
        }

        await dbContext.SaveChangesAsync(cancellationToken);
    }

    public async Task<IReadOnlyCollection<StarterPackSummary>> ListStarterPacksAsync(Guid? tenantId = null, CancellationToken cancellationToken = default)
    {
        await EnsureSystemStarterPacksSeededAsync(cancellationToken);

        var packs = await dbContext.SystemTemplatePacks
            .Where(x => x.IsSystem)
            .Include(x => x.AssetCategories.Where(category => category.TenantId == null && category.IsSystemTemplate))
                .ThenInclude(x => x.Fields)
            .Include(x => x.ChecklistTemplates.Where(template => template.TenantId == null && template.IsSystemTemplate))
                .ThenInclude(x => x.Sections)
            .Include(x => x.ChecklistTemplates.Where(template => template.TenantId == null && template.IsSystemTemplate))
                .ThenInclude(x => x.Questions)
            .Include(x => x.Installations)
            .OrderBy(x => x.Name)
            .ToListAsync(cancellationToken);

        return packs.Select(pack =>
        {
            var installation = tenantId.HasValue
                ? pack.Installations.OrderByDescending(x => x.InstalledAt).FirstOrDefault(x => x.TenantId == tenantId.Value)
                : null;

            return new StarterPackSummary(
                pack.Id,
                pack.Name,
                pack.Code,
                pack.Description,
                pack.ContractorType,
                pack.IsActive,
                pack.Version,
                installation is not null && installation.Status.Equals("Installed", StringComparison.OrdinalIgnoreCase),
                installation?.Status,
                pack.AssetCategories
                    .OrderBy(x => x.DisplayOrder)
                    .ThenBy(x => x.Name)
                    .Select(x => new StarterPackAssetCategorySummary(x.Id, x.Name, x.Code, x.Description, x.DisplayOrder, x.DefaultServiceIntervalMonths, x.Fields.Count(field => field.IsActive)))
                    .ToList(),
                pack.ChecklistTemplates
                    .OrderBy(x => x.WorkType)
                    .ThenBy(x => x.Name)
                    .Select(x => new StarterPackChecklistSummary(x.Id, x.Name, x.Code, x.WorkType, x.DefaultIntervalMonths, x.Sections.Count(section => section.IsActive), x.Questions.Count(question => question.IsActive)))
                    .ToList());
        }).ToList();
    }

    public async Task<StarterPackSummary> InstallStarterPackAsync(Guid tenantId, Guid starterPackId, Guid? actorUserId = null, CancellationToken cancellationToken = default)
    {
        await EnsureSystemStarterPacksSeededAsync(cancellationToken);

        var pack = await dbContext.SystemTemplatePacks
            .Include(x => x.AssetCategories.Where(category => category.TenantId == null && category.IsSystemTemplate))
                .ThenInclude(x => x.Fields)
            .Include(x => x.ChecklistTemplates.Where(template => template.TenantId == null && template.IsSystemTemplate))
                .ThenInclude(x => x.Sections)
            .Include(x => x.ChecklistTemplates.Where(template => template.TenantId == null && template.IsSystemTemplate))
                .ThenInclude(x => x.Questions)
            .SingleOrDefaultAsync(x => x.Id == starterPackId && x.IsSystem && x.IsActive, cancellationToken)
            ?? throw new NotFoundException("Starter pack was not found.");

        var existingInstallation = await dbContext.TenantTemplatePackInstallations
            .SingleOrDefaultAsync(x => x.TenantId == tenantId && x.SourceTemplatePackId == starterPackId, cancellationToken);

        if (existingInstallation is not null && existingInstallation.Status.Equals("Installed", StringComparison.OrdinalIgnoreCase))
        {
            return await ListInstalledPackAsync(tenantId, starterPackId, cancellationToken);
        }

        foreach (var sourceCategory in pack.AssetCategories.OrderBy(x => x.DisplayOrder))
        {
            var copy = new AssetCategory
            {
                TenantId = tenantId,
                TemplatePackId = pack.Id,
                SourceAssetCategoryId = sourceCategory.Id,
                ParentCategoryName = sourceCategory.ParentCategoryName,
                Name = sourceCategory.Name,
                Code = sourceCategory.Code,
                Description = sourceCategory.Description,
                ContractorType = sourceCategory.ContractorType,
                Icon = sourceCategory.Icon,
                IsDefault = false,
                IsActive = true,
                IsSystemTemplate = false,
                DefaultServiceIntervalMonths = sourceCategory.DefaultServiceIntervalMonths,
                DisplayOrder = sourceCategory.DisplayOrder,
                Fields = sourceCategory.Fields
                    .OrderBy(x => x.DisplayOrder)
                    .Select(field => new AssetCategoryField
                    {
                        FieldName = field.FieldName,
                        FieldLabel = field.FieldLabel,
                        FieldType = field.FieldType,
                        DropdownOptions = field.DropdownOptions,
                        Unit = field.Unit,
                        HelpText = field.HelpText,
                        IsRequired = field.IsRequired,
                        IsActive = field.IsActive,
                        DisplayOrder = field.DisplayOrder
                    })
                    .ToList()
            };

            dbContext.AssetCategories.Add(copy);
        }

        foreach (var sourceTemplate in pack.ChecklistTemplates.OrderBy(x => x.WorkType).ThenBy(x => x.Name))
        {
            var copiedSections = sourceTemplate.Sections
                .OrderBy(x => x.DisplayOrder)
                .Select(x => new PmTemplateSection
                {
                    SectionName = x.SectionName,
                    Description = x.Description,
                    DisplayOrder = x.DisplayOrder,
                    IsActive = x.IsActive
                })
                .ToList();

            var sectionMap = copiedSections.ToDictionary(x => x.SectionName, StringComparer.OrdinalIgnoreCase);
            var copy = new PmTemplate
            {
                TenantId = tenantId,
                TemplatePackId = pack.Id,
                SourceTemplateId = sourceTemplate.Id,
                AssetCategoryId = null,
                Category = sourceTemplate.Category,
                Name = sourceTemplate.Name,
                Code = sourceTemplate.Code,
                Description = sourceTemplate.Description,
                WorkType = sourceTemplate.WorkType,
                DefaultIntervalMonths = sourceTemplate.DefaultIntervalMonths,
                EstimatedDurationHours = sourceTemplate.EstimatedDurationHours,
                AutoScheduleByDefault = sourceTemplate.AutoScheduleByDefault,
                IsActive = true,
                Version = 1,
                IsPlatformSeed = false,
                IsSystemTemplate = false,
                OptionalReportSectionsJson = sourceTemplate.OptionalReportSectionsJson,
                Sections = copiedSections,
                Questions = sourceTemplate.Questions
                    .OrderBy(x => x.Section?.DisplayOrder ?? int.MaxValue)
                    .ThenBy(x => x.DisplayOrder)
                    .Select(question => new PmTemplateQuestion
                    {
                        Section = !string.IsNullOrWhiteSpace(question.SectionName) && sectionMap.TryGetValue(question.SectionName!, out var mappedSection) ? mappedSection : null,
                        SectionName = question.SectionName,
                        Prompt = question.Prompt,
                        HelperText = question.HelperText,
                        ResponseType = question.ResponseType,
                        Unit = question.Unit,
                        DefaultValue = question.DefaultValue,
                        MinValue = question.MinValue,
                        MaxValue = question.MaxValue,
                        IsRequired = question.IsRequired,
                        EvidenceRequired = question.EvidenceRequired,
                        TechnicianRemarksAllowed = question.TechnicianRemarksAllowed,
                        RequiresNoteOnFail = question.RequiresNoteOnFail,
                        IsActive = question.IsActive,
                        DisplayOrder = question.DisplayOrder,
                        OptionsJson = question.OptionsJson
                    })
                    .ToList()
            };

            dbContext.PmTemplates.Add(copy);
        }

        if (existingInstallation is null)
        {
            existingInstallation = new TenantTemplatePackInstallation
            {
                TenantId = tenantId,
                SourceTemplatePackId = starterPackId,
                InstalledByUserId = actorUserId,
                InstalledAt = DateTime.UtcNow,
                Status = "Installed"
            };
            dbContext.TenantTemplatePackInstallations.Add(existingInstallation);
        }
        else
        {
            existingInstallation.InstalledByUserId = actorUserId;
            existingInstallation.InstalledAt = DateTime.UtcNow;
            existingInstallation.Status = "Installed";
        }

        await dbContext.SaveChangesAsync(cancellationToken);
        return await ListInstalledPackAsync(tenantId, starterPackId, cancellationToken);
    }

    private async Task<StarterPackSummary> ListInstalledPackAsync(Guid tenantId, Guid starterPackId, CancellationToken cancellationToken)
    {
        var summary = await ListStarterPacksAsync(tenantId, cancellationToken);
        return summary.Single(x => x.Id == starterPackId);
    }

    private static bool Matches(string? left, string? right) =>
        string.Equals((left ?? string.Empty).Trim(), (right ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase);

