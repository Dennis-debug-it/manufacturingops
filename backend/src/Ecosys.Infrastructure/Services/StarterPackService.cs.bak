                    Field("installation_date", "Installation Date", "Date"),
                    Field("last_service_date", "Last Service Date", "Date"),
                    Field("service_interval", "Service Interval", "Dropdown", options: ["Monthly", "Quarterly", "Semi-Annual", "Annual"]),
                    Field("warranty_expiry", "Warranty Expiry", "Date")
                ]),
                AssetCategoryDefinition("inverter", "Inverter", 2, 3),
                AssetCategoryDefinition("battery-bank", "Battery Bank", 3, 3),
                AssetCategoryDefinition("charge-controller", "Charge Controller", 4, 3),
                AssetCategoryDefinition("combiner-box", "Combiner Box", 5, 3),
                AssetCategoryDefinition("solar-pump-system", "Solar Pump System", 6, 3),
                AssetCategoryDefinition("mounting-structure", "Mounting Structure", 7, 3)
            ],
            [
                Checklist(
                    "solar-pm",
                    "Solar Preventive Maintenance",
                    "Solar",
                    PreventiveMaintenance,
                    3,
                    "Routine preventive maintenance checklist for solar systems.",
                    [
                        Section("Safety and Access", 1, [
                            Item("Confirm site access approval", "checkbox", 1, required: true),
                            Item("Confirm safe working conditions", "checkbox", 2),
                            Item("Capture before-service photo", "photo", 3)
                        ]),
                        Section("PV Array and Mounting", 2, [
                            Item("Inspect solar panels", "checkbox", 1),
                            Item("Clean panel surface", "checkbox", 2),
                            Item("Check for shading/soiling", "text", 3),
                            Item("Inspect mounting structure", "checkbox", 4),
                            Item("Check roof/structure condition", "text", 5)
                        ]),
                        Section("DC and AC Electrical", 3, [
                            Item("Inspect DC cables", "checkbox", 1),
                            Item("Inspect combiner box", "checkbox", 2),
                            Item("Record PV voltage", "reading", 3, unit: "V"),
                            Item("Record PV current", "reading", 4, unit: "A"),
                            Item("Inspect AC output", "checkbox", 5),
                            Item("Check earthing/lightning protection", "checkbox", 6)
                        ]),
                        Section("Inverter and Battery", 4, [
                            Item("Check inverter status", "text", 1),
                            Item("Review inverter fault logs", "multilinetext", 2),
                            Item("Check battery voltage", "reading", 3, unit: "V"),
                            Item("Inspect battery terminals", "checkbox", 4),
                            Item("Check battery environment/ventilation", "text", 5)
                        ]),
                        Section("Completion", 5, [
                            Item("Capture after-service photo", "photo", 1),
                            Item("Technician remarks", "multilinetext", 2),
                            Item("Client representative name", "text", 3),
                            Item("Client signature", "signature", 4)
                        ])
                    ]),
                Checklist(
                    "solar-breakdown",
                    "Solar Breakdown / Corrective Maintenance",
                    "Solar",
                    BreakdownCorrective,
                    null,
                    "Corrective maintenance checklist for solar fault response.",
                    [
                        Section("Fault Response", 1, [
                            Item("Fault reported", "multilinetext", 1),
                            Item("Inverter/fault code observed", "text", 2),
                            Item("Diagnosis", "multilinetext", 3),
                            Item("Corrective action taken", "multilinetext", 4),
                            Item("Parts/materials used", "multilinetext", 5),
                            Item("System test result", "multilinetext", 6),
                            Item("Follow-up required", "checkbox", 7),
                            Item("Technician remarks", "multilinetext", 8),
                            Item("Client signature", "signature", 9)
                        ])
                    ])
            ])
    ];

    private static StarterPackSeedAssetCategoryDefinition AssetCategoryDefinition(
        string code,
        string name,
        int sortOrder,
        int? defaultIntervalMonths,
        IReadOnlyCollection<StarterPackSeedFieldDefinition>? fields = null,
        string? description = null,
        string? parentCategoryName = null) =>
        new(name, code, description, sortOrder, defaultIntervalMonths, parentCategoryName, fields ?? []);

    private static StarterPackSeedFieldDefinition Field(
        string key,
        string label,
        string fieldType,
        int sortOrder = 0,
        string? unit = null,
        bool required = false,
        IReadOnlyCollection<string>? options = null,
        string? helpText = null,
        bool isActive = true) =>
        new(label, key, fieldType, unit, required, options ?? [], helpText, sortOrder, isActive);

    private static StarterPackSeedChecklistDefinition Checklist(
        string code,
        string name,
        string category,
        string workType,
        int? defaultIntervalMonths,
        string? description,
        IReadOnlyCollection<StarterPackSeedSectionDefinition> sections,
        IReadOnlyCollection<string>? optionalReportSections = null) =>
        new(name, code, description, category, workType, defaultIntervalMonths, sections, optionalReportSections ?? []);

    private static StarterPackSeedSectionDefinition Section(
        string title,
        int sortOrder,
        IReadOnlyCollection<StarterPackSeedChecklistItemDefinition> items,
        string? description = null,
        bool isActive = true) =>
        new(title, description, sortOrder, isActive, items);

    private static StarterPackSeedChecklistItemDefinition Item(
        string label,
        string inputType,
        int sortOrder,
        string? unit = null,
        bool required = false,
        IReadOnlyCollection<string>? options = null,
        string? helpText = null,
        bool isActive = true) =>
        new(label, inputType, unit, required, options ?? [], helpText, sortOrder, isActive);

    private sealed record StarterPackSeedDefinition(
        string Name,
        string Code,
        string? Description,
        string ContractorType,
        int Version,
        IReadOnlyCollection<StarterPackSeedAssetCategoryDefinition> AssetCategories,
        IReadOnlyCollection<StarterPackSeedChecklistDefinition> Checklists);

    private sealed record StarterPackSeedAssetCategoryDefinition(
        string Name,
        string Code,
        string? Description,
        int SortOrder,
        int? DefaultIntervalMonths,
        string? ParentCategoryName,
        IReadOnlyCollection<StarterPackSeedFieldDefinition> Fields);

    private sealed record StarterPackSeedFieldDefinition(
        string Label,
        string FieldKey,
        string FieldType,
        string? Unit,
        bool IsRequired,
        IReadOnlyCollection<string> Options,
        string? HelpText,
        int SortOrder,
        bool IsActive);

    private sealed record StarterPackSeedChecklistDefinition(
        string Name,
        string Code,
        string? Description,
        string Category,
        string WorkType,
        int? DefaultIntervalMonths,
        IReadOnlyCollection<StarterPackSeedSectionDefinition> Sections,
        IReadOnlyCollection<string> OptionalReportSections);

    private sealed record StarterPackSeedSectionDefinition(
        string Title,
        string? Description,
        int SortOrder,
        bool IsActive,
        IReadOnlyCollection<StarterPackSeedChecklistItemDefinition> Items);

    private sealed record StarterPackSeedChecklistItemDefinition(
        string Label,
        string InputType,
        string? Unit,
        bool IsRequired,
        IReadOnlyCollection<string> Options,
        string? HelpText,
        int SortOrder,
        bool IsActive);
}
