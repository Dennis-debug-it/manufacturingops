      SELECT e."Id", e."AttemptCount", e."CreatedAt", e."ErrorCategory", e."ErrorMessage", e."EventKey", e."HtmlBody", e."LastAttemptAt", e."MaxAttempts", e."NextAttemptAt", e."RecipientEmail", e."RecipientName", e."ReplyToEmail", e."SenderEmail", e."SenderName", e."SentAt", e."Status", e."Subject", e."TemplateKey", e."TenantId", e."TextBody", e."TriggeredByUserId", e."UpdatedAt"
      FROM email_outbox_messages AS e
      WHERE e."Status" = 'Pending' AND (e."NextAttemptAt" IS NULL OR e."NextAttemptAt" <= @utcNow)
      ORDER BY e."CreatedAt"
      LIMIT @p
