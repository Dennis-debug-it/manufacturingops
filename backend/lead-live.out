      Executed DbCommand (2ms) [Parameters=[@p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT p1."Id", p1."AmountPaid", p1."Balance", p1."CreatedAt", p1."Currency", p1."CustomerEmail", p1."CustomerName", p1."DiscountAmount", p1."DiscountRate", p1."DueDate", p1."InvoiceNumber", p1."IssueDate", p1."Notes", p1."QuotationId", p1."Status", p1."Subtotal", p1."TaxAmount", p1."TaxRate", p1."TenantId", p1."Total", p1."UpdatedAt", p0."Id", p0."CreatedAt", p0."Description", p0."InvoiceId", p0."LineTotal", p0."Quantity", p0."Taxable", p0."UnitPrice", p0."UpdatedAt"
      FROM (
          SELECT p."Id", p."AmountPaid", p."Balance", p."CreatedAt", p."Currency", p."CustomerEmail", p."CustomerName", p."DiscountAmount", p."DiscountRate", p."DueDate", p."InvoiceNumber", p."IssueDate", p."Notes", p."QuotationId", p."Status", p."Subtotal", p."TaxAmount", p."TaxRate", p."TenantId", p."Total", p."UpdatedAt"
          FROM platform_invoices AS p
          ORDER BY p."IssueDate" DESC
