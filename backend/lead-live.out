      SELECT l."Id", l."AdvancedReports", l."AnnualPrice", l."ClientPortal", l."CreatedAt", l."DisplayName", l."EmailIngestion", l."IsActive", l."MaxAssets", l."MaxBranches", l."MaxUsers", l."ModulesIncluded", l."MonitoringIntegration", l."MonthlyPrice", l."MonthlyWorkOrders", l."PlanCode", l."UpdatedAt"
      FROM license_plans AS l
      ORDER BY l."DisplayName"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@tenantIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT u."TenantId", count(*)::int AS "Count"
      FROM users AS u
      WHERE u."TenantId" = ANY (@tenantIds) AND u."IsActive" AND u."Role" <> 'SuperAdmin'
      GROUP BY u."TenantId"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@tenantIds='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT b."TenantId", count(*)::int AS "Count"
      FROM branches AS b
      WHERE b."TenantId" = ANY (@tenantIds) AND b."IsActive"
      GROUP BY b."TenantId"
