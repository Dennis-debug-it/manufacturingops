      FROM tenants AS t
      LEFT JOIN (
          SELECT t0."Id", t0."AdvancedReportsOverride", t0."BillingCycle", t0."CancelledAt", t0."ClientPortalOverride", t0."CreatedAt", t0."EmailIngestionOverride", t0."ExpiresAt", t0."GracePeriodDays", t0."LicensePlanId", t0."MaxAssetsOverride", t0."MaxBranchesOverride", t0."MaxUsersOverride", t0."MonitoringIntegrationOverride", t0."MonthlyWorkOrdersOverride", t0."NextBillingDate", t0."Notes", t0."StartsAt", t0."Status", t0."SuspendedAt", t0."TenantId", t0."TrialEndsAt", t0."UpdatedAt", l."Id" AS "Id0", l."AdvancedReports", l."AnnualPrice", l."ClientPortal", l."CreatedAt" AS "CreatedAt0", l."DisplayName", l."EmailIngestion", l."IsActive", l."MaxAssets", l."MaxBranches", l."MaxUsers", l."ModulesIncluded", l."MonitoringIntegration", l."MonthlyPrice", l."MonthlyWorkOrders", l."PlanCode", l."UpdatedAt" AS "UpdatedAt0"
          FROM tenant_licenses AS t0
