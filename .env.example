# Copy to `.env` (git-ignored) and fill in real values before `docker compose up`.
# The API validates these at startup and refuses to boot on missing/weak/known-default values.

# ---- Postgres ----
POSTGRES_USER=ecosys
POSTGRES_PASSWORD=            # strong random password
POSTGRES_DB=ecosys

# ---- Public origin (scheme + host, no trailing slash) ----
# Used to build the frontend (VITE_API_BASE_URL) and the attachment BaseUrl.
ECOSYS_PUBLIC_URL=https://app.ecosysdigital.co.ke
WEB_PORT=8080

# ---- API secrets (REQUIRED) ----
ECOSYS_JWT_SIGNING_KEY=        # >=32 chars; generate: openssl rand -base64 48
ECOSYS_PLATFORM_ADMIN_EMAIL=admin@yourdomain.example
ECOSYS_PLATFORM_ADMIN_PASSWORD=   # >=12 chars, not a known default
ECOSYS_PLATFORM_ADMIN_FULL_NAME=Platform Admin

# Comma-separated frontend origins; CORS denies all if unset.
ECOSYS_CORS_ALLOWED_ORIGINS=https://app.ecosysdigital.co.ke

# Comma-separated reverse-proxy IPs. Required if the proxy is not on localhost,
# otherwise all users share one rate-limit bucket and audit logs record the proxy IP.
ECOSYS_KNOWN_PROXIES=

# ---- SMTP (optional) ----
ECOSYS_SMTP_HOST=
ECOSYS_SMTP_PORT=587
ECOSYS_SMTP_USE_SSL=true
ECOSYS_SMTP_USERNAME=
ECOSYS_SMTP_PASSWORD=
