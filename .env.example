# Copy to `.env` (git-ignored) and fill in real values before `docker compose up`.
# The API validates these at startup and refuses to boot on missing/weak/known-default values.

# ---- Postgres ----
POSTGRES_USER=ecosys
POSTGRES_PASSWORD=            # strong random password
POSTGRES_DB=ecosys

# ---- Public origin (REQUIRED; scheme + host, no trailing slash) ----
# The origin your users actually reach this deployment on. It drives three things:
#   * VITE_API_BASE_URL, baked into the frontend bundle at build time
#   * Storage__BaseUrl, the prefix on attachment download links
#   * App__PublicUrl, the origin in every password-reset, account-setup and ETA link the
#     API emails out. Get this wrong and those links point at somebody else's host.
# `docker compose up` refuses to start without it.
ECOSYS_PUBLIC_URL=https://serviceops.example.com
WEB_PORT=8080

# ---- API secrets (REQUIRED) ----
ECOSYS_JWT_SIGNING_KEY=        # >=32 chars; generate: openssl rand -base64 48
ECOSYS_PLATFORM_ADMIN_EMAIL=admin@yourdomain.example
ECOSYS_PLATFORM_ADMIN_PASSWORD=   # >=12 chars, not a known default
ECOSYS_PLATFORM_ADMIN_FULL_NAME=Platform Admin

# Comma-separated frontend origins; CORS denies all if unset.
ECOSYS_CORS_ALLOWED_ORIGINS=https://serviceops.example.com

# Comma-separated reverse-proxy IPs. Required if the proxy is not on localhost,
# otherwise all users share one rate-limit bucket and audit logs record the proxy IP.
ECOSYS_KNOWN_PROXIES=

# ---- SPA Content-Security-Policy (optional) ----
# Extra origins appended to the frontend's `connect-src`, space-separated. Leave empty for
# the shipped stack, where nginx proxies /api, /hubs and /files on the SPA's own origin, so
# `connect-src 'self'` already covers everything. Set it only when the API or the SignalR
# hub is on a DIFFERENT origin, and list those origins - never `*`:
#   ECOSYS_CSP_CONNECT_SRC=https://api.example.com wss://api.example.com
ECOSYS_CSP_CONNECT_SRC=

# ---- Workspace time zone (optional) ----
# IANA zone used when neither the tenant nor the platform has set one.
ECOSYS_DEFAULT_TIME_ZONE=Africa/Nairobi

# ---- Backups (optional) ----
# Where `docker compose --profile backup run --rm db-backup` writes dumps ON THE HOST, and
# how long they are kept. A host path, deliberately: a named volume would be destroyed by
# the same `docker compose down -v` the backups exist to survive. See docs/DEPLOYMENT.md.
ECOSYS_BACKUP_DIR=./backups
ECOSYS_BACKUP_RETENTION_DAYS=14

# ---- SMTP (optional) ----
ECOSYS_SMTP_HOST=
ECOSYS_SMTP_PORT=587
ECOSYS_SMTP_USE_SSL=true
ECOSYS_SMTP_USERNAME=
ECOSYS_SMTP_PASSWORD=

# ---- Self sign-up ----
# The public "Start free trial" page: a company confirms its email and gets a 14-day trial
# workspace. Needs SMTP above. Set false to take new customers through Request a demo only.
ECOSYS_SELF_SIGNUP_ENABLED=true
