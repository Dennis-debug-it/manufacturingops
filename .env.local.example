# For a local trial only (see docker-compose.local.yml). Copy to `.env`.
# These values are for your own machine; never use them on a server.

POSTGRES_USER=ecosys
POSTGRES_PASSWORD=local-only-db-password
POSTGRES_DB=ecosys

ECOSYS_PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
ECOSYS_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Docker's private address ranges, so the API sees real client addresses through nginx.
ECOSYS_KNOWN_PROXIES=172.16.0.0/12

# Not one of the denylisted defaults, but still only for a local trial.
ECOSYS_JWT_SIGNING_KEY=local-trial-signing-key-0f3c9a7e51d24b8c96e1
ECOSYS_PLATFORM_ADMIN_EMAIL=platform@local.test
ECOSYS_PLATFORM_ADMIN_PASSWORD=Local-Platform-2026
ECOSYS_PLATFORM_ADMIN_FULL_NAME="Platform Admin"

# No email locally: invitations and password resets are not sent.
ECOSYS_SELF_SIGNUP_ENABLED=false
