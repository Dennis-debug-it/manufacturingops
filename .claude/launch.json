{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ecosys-serviceops-frontend", "run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ecosys-serviceops-frontend", "run", "preview"],
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/Ecosys.Api", "--urls", "http://localhost:5072"],
      "port": 5072,
      "autoPort": false,
      "env": {
        "ConnectionStrings__DefaultConnection": "Host=localhost;Port=5432;Database=ecosys_serviceops;Username=postgres;Password=postgres",
        "Jwt__SigningKey": "local-dev-only-signing-key-not-for-production-use-32chars",
        "PlatformAdmin__Email": "platform.owner@ecosys.dev",
        "PlatformAdmin__Password": "DevPlatform#2026",
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
