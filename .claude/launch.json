{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ecosys-serviceops-frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ecosys-serviceops-frontend", "run", "preview"],
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set Jwt__SigningKey=local-dev-only-signing-key-not-for-production-use-32chars && dotnet run --project backend/src/Ecosys.Api --urls http://localhost:5072"],
      "port": 5072
    }
  ]
}
